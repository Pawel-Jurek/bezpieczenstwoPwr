{
  "name": "bbotd",
  "version": "0.3.1-beta.5",
  "description": "Detect basic bots on your website easily.",
  "keywords": [
    "bot-detection",
    "security"
  ],
  "sideEffects": true,
  "homepage": "https://pawel-jurek.github.io/bezpieczenstwoPwr/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pawel-Jurek/bezpieczenstwoPwr.git"
  },
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "author": "Krystian Ogonowski",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "rollup -c",
    "prepare": "npm run build",
    "watch": "rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@rollup/plugin-url": "^8.0.2",
    "rollup": "^2.79.2",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "peerDependencies": {
    "@tensorflow/tfjs": "^4.22.0"
  }
}
